[core]
	editor = /opt/homebrew/bin/vim
[push]
  default = simple
  autoSetupRemote = true
[credential]
	helper = osxkeychain
[rerere]
	enabled = true
[rebase]
	autosquash = true
[commit]
	gpgsign = true
  verbose = true
[pull]
	rebase = true
[branch]
  sort = -committerdate
[tag]
  sort = version:refname
[init]
  defaultBranch = main
[diff]
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[fetch]
  prune = true
  pruneTags = true
  all = true
